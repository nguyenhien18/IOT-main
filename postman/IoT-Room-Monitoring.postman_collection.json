{
  "info": {
    "_postman_id": "f03ef8a8-183a-4b72-a749-2ba743d30ac3",
    "name": "IoT Room Monitoring API",
    "description": "Bo request kiem thu REST API cho du an IoT Room Monitoring. Chay request Login truoc de tu dong luu JWT vao environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwtToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response la JSON', function () {",
          "    pm.response.to.be.json;",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Authentication",
      "item": [
        {
          "name": "Login - Lay JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dang nhap thanh cong', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.result).to.have.property('token');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.result && body.result.token) {",
                  "    pm.collectionVariables.set('jwtToken', body.result.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Dang nhap va tu dong luu JWT vao bien jwtToken cua environment."
          }
        }
      ]
    },
